rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCreator() {
      return isSignedIn() && request.auth.token.role == 'creator';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'player';
      allow update, delete: if false; // role changes go through the setCreatorRole admin script only
    }

    match /characters/{characterId} {
      allow read: if isCreator() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isCreator() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow delete: if isCreator();
    }

    match /actionsLog/{logId} {
      allow read: if isCreator() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false; // only written by Cloud Functions (performAction)
    }

    match /instances/{instanceId} {
      allow read: if isCreator() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false; // only written by Cloud Functions (acknowledgeAction)
    }

    match /worldData/{document=**} {
      allow read: if isSignedIn();
      allow write: if isCreator();
    }
  }
}
